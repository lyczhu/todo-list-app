# ============================================================
# Java / Spring Boot / Maven (backend/)
# ============================================================
target/
*.class
*.jar
*.war
*.ear
# 注意: 不要忽略 Maven Wrapper 自带的 jar
!**/maven-wrapper.jar
!**/maven-wrapper.properties

# 构建/测试结果
build/
!**/src/main/**/build/
!**/src/test/**/build/
bin/
!**/src/main/**/bin/
!**/src/test/**/bin/
*.log

# ============================================================
# SQLite 数据 (backend/data/)
# ============================================================
backend/data/
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-shm
*.db-wal

