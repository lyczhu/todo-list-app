# Node / Vite / Vue (frontend/)
# ============================================================
node_modules/
dist/
dist-ssr/
.vite/
*.local
coverage/
.nyc_output/

# npm / yarn / pnpm 锁文件之外的缓存
.eslintcache
.stylelintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ============================================================
# 环境变量与密钥
